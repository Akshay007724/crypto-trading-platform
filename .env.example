# Data plane (existing)
DATABASE_URL=postgresql://hft:hft@localhost:5432/hft
REDIS_URL=redis://localhost:6379
KRAKEN_SYMBOL=BTC/USD

# Finnhub (equities REST) — free key: finnhub.io/register
FINNHUB_API_KEY=

# Agentic layer — all optional. Unset -> agent console shows "unavailable",
# deterministic quotes/charts/orderbook are unaffected.
# Defaults to OpenRouter (openrouter.ai/keys) — any OpenAI-compatible
# provider works by changing LLM_BASE_URL/LLM_MODEL (e.g. DeepSeek direct:
# https://api.deepseek.com + model "deepseek-chat").
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-chat

# Real-time cache. Unset -> falls back to Upstash-free-tier-shaped REDIS_URL,
# and further falls back to an in-process cache if unreachable.
UPSTASH_REDIS_URL=

# Time-series persistence. Unset -> falls back to a local SQLite file
# (LOCAL_TIMESERIES_DB) — no Supabase project required to run this locally.
SUPABASE_URL=
SUPABASE_KEY=
LOCAL_TIMESERIES_DB=timeseries.db

# Guardrails
QUOTE_CACHE_TTL_S=5
AGENT_MAX_STEPS=6
AGENT_TIMEOUT_S=20
AGENT_COST_CEILING_USD=0.05
AGENT_OUTPUT_CACHE_TTL_S=60
